{
  "permissions": {
    "allow": [
      "Read(//Users/ryu/Documents/pythonweb/AITHUCCHIEN-P/frontend/**)",
      "Read(//Users/ryu/Documents/pythonweb/AITHUCCHIEN-P/frontend/app/**)",
      "Read(//Users/ryu/Documents/pythonweb/AITHUCCHIEN-P/frontend/components/layout/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=claude",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=claude",
            "shell": "bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=claude",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
