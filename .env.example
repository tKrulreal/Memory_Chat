# ============================================
# MemoryChat — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
#   cp .env.example .env
# NEVER commit .env to git!

# ---- App Config ----
APP_ENV=development
DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Frontend Port ----
FRONTEND_PORT=3000

# ---- Logging ----
LOG_LEVEL=INFO
# Directory for AI prompt/response logs (JSON Lines format)
AI_LOG_DIR=.ai-log

# ---- LLM Configuration ----
# Option 1: OpenAI (default)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Option 2: OpenRouter (recommended for cost savings)
# Set USE_OPENROUTER=true and provide your OpenRouter API key
USE_OPENROUTER=false
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Common OpenRouter models:
#   anthropic/claude-3-haiku (fast, cheap)
#   anthropic/claude-3-sonnet
#   openai/gpt-4o-mini
#   openai/gpt-4o
#   google/gemini-pro-1.5

# General settings
LLM_TIMEOUT=30
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
EMBEDDING_MODEL=text-embedding-3-small

# ---- Auth ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_MINUTES=15

# ---- Email / Password Reset ----
# Configure SMTP to deliver password-reset links. Leave SMTP_HOST empty to disable delivery locally.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@example.com

# ---- PostgreSQL (Docker) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=memorychat
POSTGRES_PORT=5432

# ---- Database URL ----
# When running locally (without Docker backend):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memorychat
# When running inside Docker Compose — uses service name 'postgres':
#   DATABASE_URL is automatically set in docker-compose.yml — do NOT override here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memorychat

# ---- Vector Store — Qdrant Cloud ----
# Register at: https://cloud.qdrant.io
# Create a cluster and get your URL + API key
QDRANT_URL=https://YOUR-CLUSTER-ID.YOUR-REGION.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key-here
QDRANT_COLLECTION=assistant_memories

# ---- Next.js Frontend ----
# URL that the browser uses to call the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- LangSmith (Optional - for AI tracing) ----
# LANGCHAIN_API_KEY=your-langsmith-key-here
# LANGCHAIN_PROJECT=memorychat-agent
# LANGCHAIN_TRACING_V2=true

# ---- AI Log Server (Optional) ----
# AI_LOG_SERVER=https://your-log-server/api/ingest
# AI_LOG_API_KEY=your-log-api-key
