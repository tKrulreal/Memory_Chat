# ============================================
# MemoryChat — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Logging ----
LOG_LEVEL=INFO
# Directory for AI prompt/response logs (JSON Lines format)
AI_LOG_DIR=.ai-log

# ---- LLM Configuration ----
# Option 1: OpenAI (default)
OPENAI_API_KEY=sk-your-key-here

# Option 2: OpenRouter (recommended for cost savings)
# Set USE_OPENROUTER=true and provide your OpenRouter API key
USE_OPENROUTER=false
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
OPENROUTER_MODEL=anthropic/claude-3-haiku  # Default model on OpenRouter

# Common OpenRouter models:
#   anthropic/claude-3-haiku (fast, cheap)
#   anthropic/claude-3-sonnet
#   openai/gpt-4o-mini
#   openai/gpt-4o
#   google/gemini-pro-1.5

# General settings
LLM_TIMEOUT=30
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
EMBEDDING_MODEL=text-embedding-3-small

# ---- Auth ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE_MINUTES=60

# ---- Database ----
# SQLite for development:
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/memorychat

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- LangSmith (Optional - for AI tracing) ----
# LANGCHAIN_API_KEY=your-langsmith-key-here
# LANGCHAIN_PROJECT=memorychat-agent
# LANGCHAIN_TRACING_V2=true
